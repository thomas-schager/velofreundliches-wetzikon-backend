<?php

/**
 * One-off console command runner for hosts without SSH. See DEPLOY.md §7.
 *
 * DO NOT upload this file as-is:
 *   1. Copy it to public/_console.php
 *   2. Replace CHANGE-ME below with a long random string (e.g. `openssl rand -hex 32`)
 *   3. Upload public/_console.php via FTP
 *   4. Call it once (see DEPLOY.md for example URLs)
 *   5. Delete public/_console.php from the server immediately after use
 *
 * Never leave this file live on the server between uses -- it executes arbitrary
 * Symfony console commands for anyone who knows the token.
 */

require dirname(__DIR__).'/vendor/autoload_runtime.php';

use Symfony\Component\Console\Application;
use Symfony\Component\Console\Input\ArrayInput;
use Symfony\Component\Console\Output\BufferedOutput;

const DEPLOY_TOKEN = 'CHANGE-ME';

if (!hash_equals(DEPLOY_TOKEN, $_GET['token'] ?? '')) {
    http_response_code(404);
    exit;
}

$params = $_GET;
unset($params['token']);
$params['command'] ??= 'doctrine:migrations:status';
$params['--no-interaction'] = true;

$kernel = new App\Kernel($_SERVER['APP_ENV'] ?? 'prod', false);
$application = new Application($kernel);
$application->setAutoExit(false);

$output = new BufferedOutput();
$exitCode = $application->run(new ArrayInput($params), $output);

header('Content-Type: text/plain');
echo "exit code: {$exitCode}\n\n";
echo $output->fetch();
