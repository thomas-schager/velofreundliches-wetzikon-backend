# Copy this file to deploy.env (gitignored) and fill in your values.
# deploy.sh, promote.sh, and refresh-test-from-prod.sh all source it (via lib.sh).

SSH_HOST=example.com
SSH_USER=youruser
SSH_PORT=22

# Fixed, real directories on the server -- see internals.md. Each contains its own app/
# (composer project root, .env.local, migrations/, etc.) with app/public as the document root
# configured directly in Hostpoint's control panel. No symlinks, no releases/current --
# deploys rsync straight into these paths.
REMOTE_BASE_PATH_TEST=/home/youruser/www/test-example.com
REMOTE_BASE_PATH_PRODUCTION=/home/youruser/www/example.com

# Expected database name per environment -- pure safety check, not used to connect. Every
# script verifies the DATABASE_URL actually found in that environment's .env.local names
# exactly this database before doing anything, so a hand-edited or miscopied .env.local on the
# server can never cause a backup/migration/refresh to silently operate on the wrong database.
DB_NAME_TEST=your_test_db
DB_NAME_PRODUCTION=your_prod_db

# Single source of truth for the PHP version on Hostpoint -- drives REMOTE_PHP_BIN below, and
# must match the "Use php-fpm <version>" line at the top of public/.htaccess (that file can't
# read this variable, being static -- deploy.sh/promote.sh check the two match before doing
# anything else and refuse to proceed if they've drifted apart). The plain `php` on Hostpoint
# resolves to 8.3 (too old for this app's composer.json); 8.4 isn't offered at all, but 8.5 is,
# confirmed via `ssh <ssh_user>@<ssh_host> /usr/local/php85/bin/php -v` -> 8.5.9. See
# internals.md for the real SSH details. Deliberately a versioned name, not the `php-head`
# alias for REMOTE_PHP_BIN below -- "head" tracks whatever
# Hostpoint currently calls newest, so it could silently point at a different version later.
PHP_VERSION=php85
REMOTE_PHP_BIN=/usr/local/${PHP_VERSION}/bin/php
