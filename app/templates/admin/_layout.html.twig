<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}Velofreundliches Wetzikon Admin{% endblock %}</title>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('assets/tokens.css') }}">
<link rel="stylesheet" href="{{ asset('assets/admin.css') }}">
{% block extra_head %}{% endblock %}
</head>
<body data-page="{{ nav_page|default('') }}">

<div class="adm-shell">
  <div class="adm-mobile-scrim"></div>

  <aside class="adm-sidebar">
    <div class="adm-sidebar__head">
      <a href="{{ path('admin_dashboard') }}" class="vw-logo" style="pointer-events:none;">
        <span class="vw-logo__bar"></span>
        <span class="vw-logo__text">
          <span class="vw-logo__top">velofreundliches</span>
          <span class="vw-logo__bottom">WETZIKON</span>
        </span>
      </a>
    </div>
    <nav class="adm-sidebar__nav">
      <div class="adm-sidebar__section">Übersicht</div>
      <a class="adm-navlink" data-page="dashboard" href="{{ path('admin_dashboard') }}"><i data-lucide="layout-dashboard"></i><span class="adm-navlink__label">Übersicht</span></a>

      <div class="adm-sidebar__section">VeloMelder</div>
      <a class="adm-navlink" data-page="meldungen" href="{{ path('admin_meldungen') }}"><i data-lucide="message-square-warning"></i><span class="adm-navlink__label">Meldungen</span>{% if pending_count is defined and pending_count > 0 %}<span class="adm-navlink__badge">{{ pending_count }}</span>{% endif %}</a>
      <a class="adm-navlink" data-page="routen" href="{{ path('admin_routes') }}"><i data-lucide="route"></i><span class="adm-navlink__label">Routen</span></a>

      <div class="adm-sidebar__section">Verwaltung</div>
      <a class="adm-navlink is-disabled" href="#"><i data-lucide="users"></i><span class="adm-navlink__label">Benutzer</span><span class="adm-navlink__soon">Bald</span></a>
      <a class="adm-navlink is-disabled" href="#"><i data-lucide="settings"></i><span class="adm-navlink__label">Einstellungen</span><span class="adm-navlink__soon">Bald</span></a>
    </nav>
    <div class="adm-sidebar__foot">
      <button class="adm-collapse-btn" id="admCollapseBtn">
        <i data-lucide="panel-left-close" width="18" height="18"></i>
        <span>Einklappen</span>
      </button>
    </div>
  </aside>

  <div class="adm-content">
    <header class="adm-topbar">
      <button class="adm-topbar__burger" id="admBurger"><i data-lucide="menu"></i></button>
      <span class="adm-topbar__title">{% block topbar_title %}{% endblock %}</span>
      <span class="adm-topbar__spacer"></span>
      {% set admin_name = app.user ? app.user.displayName : '' %}
      {% set admin_initials = '' %}
      {% for part in admin_name|split(' ') %}
        {% if part is not empty and admin_initials|length < 2 %}
          {% set admin_initials = admin_initials ~ (part|first|upper) %}
        {% endif %}
      {% endfor %}
      <div class="adm-user-menu" id="admUserMenu">
        <button type="button" class="adm-topbar__user" id="admUserMenuTrigger" aria-haspopup="true" aria-expanded="false">
          <span class="adm-avatar">{{ admin_initials|default('--') }}</span>
          <span class="adm-topbar__user-name">{{ admin_name }}</span>
          <i data-lucide="chevron-down" width="14" height="14" class="adm-user-menu__chevron"></i>
        </button>
        <div class="adm-user-menu__dropdown" id="admUserMenuDropdown">
          {% if app.user %}<div class="adm-user-menu__email">{{ app.user.email }}</div>{% endif %}
          <button type="button" class="adm-user-menu__item" id="admLogoutBtn">
            <i data-lucide="log-out" width="15" height="15"></i> Abmelden
          </button>
        </div>
      </div>
    </header>

    {% block body %}{% endblock %}
  </div>
</div>

<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<script src="{{ asset('assets/admin.js') }}"></script>
{% block extra_scripts %}{% endblock %}
</body>
</html>
