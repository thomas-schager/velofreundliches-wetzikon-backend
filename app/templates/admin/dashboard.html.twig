{% extends 'admin/_layout.html.twig' %}
{% block title %}Übersicht — Velofreundliches Wetzikon Admin{% endblock %}
{% block topbar_title %}Übersicht{% endblock %}

{% block body %}
<main class="adm-main">
  <div class="adm-page-head">
    <div>
      <h1>Guten Tag{{ admin_first_name ? ', ' ~ admin_first_name : '' }}</h1>
      <p>Hier ist, was heute ansteht.</p>
    </div>
  </div>

  <div class="adm-stat-grid">
    <div class="adm-stat-card adm-stat-card--accent">
      <div class="adm-stat-card__label">Zu prüfen <i data-lucide="clock" width="14" height="14"></i></div>
      <div class="adm-stat-card__value">{{ pending_count }}</div>
      <a class="adm-stat-card__link" href="{{ path('admin_meldungen') }}?status=pending_review">Jetzt prüfen <i data-lucide="arrow-right" width="12" height="12"></i></a>
    </div>
    <div class="adm-stat-card">
      <div class="adm-stat-card__label">Veröffentlicht <i data-lucide="check-circle" width="14" height="14"></i></div>
      <div class="adm-stat-card__value">{{ published_30d }} <small>/ 30 Tage</small></div>
      <a class="adm-stat-card__link" href="{{ path('admin_meldungen') }}?status=published">Ansehen <i data-lucide="arrow-right" width="12" height="12"></i></a>
    </div>
    <div class="adm-stat-card">
      <div class="adm-stat-card__label">Abgelehnt <i data-lucide="x-circle" width="14" height="14"></i></div>
      <div class="adm-stat-card__value">{{ declined_30d }} <small>/ 30 Tage</small></div>
      <a class="adm-stat-card__link" href="{{ path('admin_meldungen') }}?status=declined">Ansehen <i data-lucide="arrow-right" width="12" height="12"></i></a>
    </div>
    <div class="adm-stat-card">
      <div class="adm-stat-card__label">Routen-Segmente <i data-lucide="route" width="14" height="14"></i></div>
      <div class="adm-stat-card__value">{{ route_segments_count }}</div>
      <a class="adm-stat-card__link" href="{{ path('admin_routes_placeholder') }}">Ansehen <i data-lucide="arrow-right" width="12" height="12"></i></a>
    </div>
  </div>

  <div class="adm-section-title">
    <span>Neue Meldungen — zu prüfen</span>
    <a href="{{ path('admin_meldungen') }}?status=pending_review">Alle {{ pending_count }} anzeigen</a>
  </div>

  <div class="adm-table-wrap">
    <div class="adm-queue">
      {% for r in recent_pending %}
      <a class="adm-queue-row" href="{{ path('admin_meldung_detail', {id: report_id(r.id)}) }}">
        <span class="adm-queue-row__rating"><span class="adm-rate-pill" data-r="{{ r.rating }}">{{ r.rating }}</span></span>
        <span class="adm-queue-row__body">
          <span class="adm-queue-row__title">{{ r.comment|length > 140 ? r.comment|slice(0, 140) ~ '…' : r.comment }}</span>
          <span class="adm-queue-row__meta">
            <span><i data-lucide="map-pin" width="12" height="12"></i> {{ r.address ?: (r.lat ~ ', ' ~ r.lng) }}</span>
            <span><i data-lucide="clock" width="12" height="12"></i> {{ r.createdAt|relative_de }}</span>
            <span><i data-lucide="user" width="12" height="12"></i> {{ r.anonymous ? 'Anonym' : r.name }}</span>
          </span>
        </span>
        <i data-lucide="chevron-right" class="adm-queue-row__chev" width="18" height="18"></i>
      </a>
      {% else %}
      <p style="padding:16px;color:var(--color-muted);">Keine neuen Meldungen.</p>
      {% endfor %}
    </div>
  </div>
</main>
{% endblock %}
