<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Neues Passwort — Velofreundliches Wetzikon Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('assets/tokens.css') }}">
<link rel="stylesheet" href="{{ asset('assets/admin.css') }}">
</head>
<body>

<div class="adm-auth">
  <aside class="adm-auth__side">
    <div class="adm-auth__side-top">
      <a href="{{ path('admin_login') }}" class="vw-logo" style="pointer-events:none;">
        <span class="vw-logo__bar"></span>
        <span class="vw-logo__text">
          <span class="vw-logo__top">velofreundliches</span>
          <span class="vw-logo__bottom">WETZIKON</span>
        </span>
      </a>
    </div>
  </aside>

  <div class="adm-auth__main">
    <div class="adm-auth__card">
      <div class="adm-auth__logo-mobile">
        <a href="{{ path('admin_login') }}" class="vw-logo" style="pointer-events:none;">
          <span class="vw-logo__bar"></span>
          <span class="vw-logo__text">
            <span class="vw-logo__top">velofreundliches</span>
            <span class="vw-logo__bottom">WETZIKON</span>
          </span>
        </a>
      </div>

      <span class="adm-auth__eyebrow">Admin-Bereich</span>
      <h1 class="adm-auth__title">Neues Passwort</h1>

      <div id="resetError" class="adm-alert adm-alert--error" style="display:none;">
        <i data-lucide="alert-circle" width="16" height="16"></i>
        <span id="resetErrorText">Etwas ist schiefgelaufen.</span>
      </div>

      <form id="resetForm" novalidate>
        <div class="adm-field">
          <label class="adm-label" for="pw1">Neues Passwort <span class="adm-required">*</span></label>
          <input type="password" id="pw1" name="pw1" autocomplete="new-password" placeholder="••••••••••••" required minlength="12">
          <p class="adm-field-note">Mindestens 12 Zeichen.</p>
        </div>
        <div class="adm-field">
          <label class="adm-label" for="pw2">Passwort bestätigen <span class="adm-required">*</span></label>
          <input type="password" id="pw2" name="pw2" autocomplete="new-password" placeholder="••••••••••••" required minlength="12">
          <p class="adm-field-error" id="pwError" style="display:none;">Die Passwörter stimmen nicht überein.</p>
        </div>
        <button type="submit" class="adm-btn adm-btn--primary adm-btn--block">
          Passwort speichern <i data-lucide="check" width="16" height="16"></i>
        </button>
      </form>
    </div>
  </div>
</div>

<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  if (typeof lucide !== 'undefined') lucide.createIcons();
  var resetToken = new URLSearchParams(window.location.search).get('resetToken') || '';
  var form = document.getElementById('resetForm');
  var err = document.getElementById('pwError');
  var errorBox = document.getElementById('resetError');
  var errorText = document.getElementById('resetErrorText');

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    err.style.display = 'none';
    errorBox.style.display = 'none';
    var pw1 = document.getElementById('pw1').value;
    var pw2 = document.getElementById('pw2').value;
    if (pw1.length < 12 || pw1 !== pw2) {
      err.style.display = 'block';
      return;
    }

    fetch('{{ path('api_auth_reset_password') }}', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ resetToken: resetToken, newPassword: pw1 })
    }).then(function (res) {
      if (res.ok) {
        window.location.href = '{{ path('admin_login') }}?reset=1';
        return;
      }
      return res.json().then(function (body) {
        errorText.textContent = body.message || 'Der Reset-Link ist ungültig oder abgelaufen.';
        errorBox.style.display = 'flex';
      });
    }).catch(function () {
      errorText.textContent = 'Verbindung zum Server fehlgeschlagen.';
      errorBox.style.display = 'flex';
    });
  });
});
</script>
</body>
</html>
