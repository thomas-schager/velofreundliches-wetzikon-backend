# This directory holds user-uploaded report photos (ReportSubmissionService). Filenames are
# random and extensions are guessed from the real MIME type, but as defense-in-depth, scripts
# are never allowed to execute here even if something slips past that.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php\d?|phtml|pl|py|cgi|sh)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php\d?|phtml|pl|py|cgi|sh)$">
        Deny from all
    </FilesMatch>
</IfModule>

# Every file here is immutable once written -- PhotoConversionService gives each upload a fresh
# random filename and nothing ever overwrites one in place (see ReportSubmissionService) -- so a
# year-long, "immutable" cache is safe: a browser that already has a given file will never need
# to re-check or re-fetch it.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
